# TEMPORARY: lucide-angular@1.0.0 (unscoped) declares a peer of @angular 13.x–21.x
# and has no Angular 22 release. The storefront still uses its API
# (LucideAngularModule.pick / unprefixed icon data). Angular 22 works with it at
# runtime, but npm's strict peer resolution blocks the install without this.
#
# Remove this line once the storefront migrates to the successor package
# @lucide/angular (provideLucideIcons + LucideIconComponent) — see the Angular 22
# upgrade notes. Do NOT rely on legacy-peer-deps for new dependencies.
legacy-peer-deps=true
