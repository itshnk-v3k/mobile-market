datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Locale {
  EN
  RU
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum SpecInputType {
  TEXT
  NUMBER
  SELECT
  BOOLEAN
}

enum BadgeVariant {
  NEW
  SALE
  USED
  HOT
  POPULAR
  OUT_OF_STOCK
}

enum CashbackTxType {
  EARNED
  SPENT
  EXPIRED
  ADJUSTED
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  PAYMENT_FAILED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String?   @map("password_hash")
  googleId        String?   @unique @map("google_id")
  role            UserRole  @default(CUSTOMER)
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  cashbackAccount CashbackAccount?
  favorites       Favorite[]
  orders          Order[]
  carts           Cart[]
  refreshTokens   RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  jti       String    @unique
  userId    String    @map("user_id")
  revokedAt DateTime? @map("revoked_at")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model StoreLocation {
  id            String   @id @default(uuid())
  isActive      Boolean  @default(true) @map("is_active")
  isPublished   Boolean  @default(false) @map("is_published")
  draftData     Json?    @map("draft_data")
  pendingDelete Boolean  @default(false) @map("pending_delete")

  city          String
  address       String
  latitude      Decimal? @db.Decimal(9, 6)
  longitude     Decimal? @db.Decimal(9, 6)
  phone         String?
  workingHours  String?  @map("working_hours")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("store_locations")
}

model Category {
  id            String   @id @default(uuid())
  slug          String   @unique
  isPublished   Boolean  @default(false) @map("is_published")
  draftData     Json?    @map("draft_data")
  pendingDelete Boolean  @default(false) @map("pending_delete")
  sortOrder     Int      @default(0) @map("sort_order")

  parentId      String?  @map("parent_id")
  parent        Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children      Category[] @relation("CategoryTree")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  translations  CategoryTranslation[]
  specFields    SpecTemplateField[]
  products      Product[]

  @@index([parentId])
  @@map("categories")
}

model CategoryTranslation {
  id          String   @id @default(uuid())
  categoryId  String   @map("category_id")
  locale      Locale
  name        String
  description String?  @db.Text

  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@map("category_translations")
}

model SpecTemplateField {
  id           String   @id @default(uuid())
  categoryId   String   @map("category_id")
  key          String
  group        String
  inputType    SpecInputType @map("input_type")
  unit         String?
  sortOrder    Int      @default(0) @map("sort_order")
  isFilterable Boolean  @default(false) @map("is_filterable")

  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  labels       SpecFieldTranslation[]
  values       ProductSpecValue[]

  @@unique([categoryId, key])
  @@map("spec_template_fields")
}

model SpecFieldTranslation {
  id      String            @id @default(uuid())
  fieldId String            @map("field_id")
  locale  Locale
  label   String

  field   SpecTemplateField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([fieldId, locale])
  @@map("spec_field_translations")
}

model Product {
  id              String   @id @default(uuid())
  slug            String   @unique
  sku             String   @unique
  categoryId      String   @map("category_id")
  brand           String

  price           Decimal  @db.Decimal(10, 2)
  oldPrice        Decimal? @db.Decimal(10, 2) @map("old_price")
  compareAtPrice  Decimal? @db.Decimal(10, 2) @map("compare_at_price")
  cashbackPercent Decimal? @db.Decimal(5, 2) @map("cashback_percent")

  isPublished     Boolean  @default(false) @map("is_published")
  draftData       Json?    @map("draft_data")
  pendingDelete   Boolean  @default(false) @map("pending_delete")

  inStock         Boolean  @default(true) @map("in_stock")
  stockQty        Int      @default(0) @map("stock_qty")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  category        Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  translations    ProductTranslation[]
  specs           ProductSpecValue[]
  images          ProductImage[]
  badges          ProductBadge[]
  installments    ProductInstallmentPlan[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  favoritedBy     Favorite[]

  @@index([categoryId])
  @@map("products")
}

model ProductTranslation {
  id          String  @id @default(uuid())
  productId   String  @map("product_id")
  locale      Locale
  name        String
  description String? @db.Text

  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@map("product_translations")
}

model ProductSpecValue {
  id        String            @id @default(uuid())
  productId String            @map("product_id")
  fieldId   String            @map("field_id")
  value     String

  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  field     SpecTemplateField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([productId, fieldId])
  @@map("product_spec_values")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  url       String
  altText   String? @map("alt_text")
  sortOrder Int     @default(0) @map("sort_order")

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductBadge {
  id        String       @id @default(uuid())
  productId String       @map("product_id")
  variant   BadgeVariant

  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_badges")
}

model InstallmentPlan {
  id           String   @id @default(uuid())
  months       Int
  interestRate Decimal  @default(0) @db.Decimal(5, 2) @map("interest_rate")
  isActive     Boolean  @default(true) @map("is_active")

  products     ProductInstallmentPlan[]

  @@map("installment_plans")
}

model ProductInstallmentPlan {
  productId String           @map("product_id")
  planId    String           @map("plan_id")

  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  plan      InstallmentPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([productId, planId])
  @@map("product_installment_plans")
}

model CashbackAccount {
  id           String                @id @default(uuid())
  userId       String                @unique @map("user_id")
  balance      Decimal               @default(0) @db.Decimal(10, 2)

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CashbackTransaction[]

  @@map("cashback_accounts")
}

model CashbackTransaction {
  id        String           @id @default(uuid())
  accountId String           @map("account_id")
  orderId   String?          @map("order_id")
  type      CashbackTxType
  amount    Decimal          @db.Decimal(10, 2)
  note      String?
  createdAt DateTime         @default(now()) @map("created_at")

  account   CashbackAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  order     Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@map("cashback_transactions")
}

model Cart {
  id         String     @id @default(uuid())
  userId     String?    @map("user_id")
  guestToken String?    @unique @map("guest_token")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items      CartItem[]

  @@map("carts")
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String  @map("cart_id")
  productId String  @map("product_id")
  quantity  Int     @default(1)

  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Order {
  id                String        @id @default(uuid())
  userId            String        @map("user_id")
  status            OrderStatus   @default(PENDING)
  total             Decimal       @db.Decimal(10, 2)
  cashbackEarned    Decimal       @default(0) @db.Decimal(10, 2) @map("cashback_earned")
  cashbackSpent     Decimal       @default(0) @db.Decimal(10, 2) @map("cashback_spent")
  installmentPlanId String?       @map("installment_plan_id")
  termsAcceptedAt   DateTime      @map("terms_accepted_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  user              User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  items             OrderItem[]
  cashbackTx        CashbackTransaction[]
  payment           Payment?

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id              String  @id @default(uuid())
  orderId         String  @map("order_id")
  productId       String  @map("product_id")
  quantity        Int
  priceAtPurchase Decimal @db.Decimal(10, 2) @map("price_at_purchase")

  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("order_items")
}

model Payment {
  id         String        @id @default(uuid())
  orderId    String        @unique @map("order_id")
  provider   String        @default("maib")
  status     PaymentStatus
  externalId String?       @map("external_id")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Favorite {
  userId    String  @map("user_id")
  productId String  @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@map("favorites")
}

model TranslationKey {
  id        String              @id @default(uuid())
  key       String              @unique
  namespace String
  values    TranslationValue[]

  @@map("translation_keys")
}

model TranslationValue {
  id     String         @id @default(uuid())
  keyId  String         @map("key_id")
  locale Locale
  value  String         @db.Text

  key    TranslationKey @relation(fields: [keyId], references: [id], onDelete: Cascade)

  @@unique([keyId, locale])
  @@map("translation_values")
}
