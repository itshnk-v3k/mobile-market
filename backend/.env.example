# Copy to backend/.env and fill in real values for local dev (.env is gitignored).

DATABASE_URL="postgresql://mobile_market:password@localhost:5432/mobile_market_db"

JWT_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=5000

# Password for the seeded admin account (npx prisma db seed).
ADMIN_SEED_PASSWORD="admin12345"

# Public storefront base URL — OAuth callbacks redirect here (…/auth/callback?code=…).
FRONTEND_URL="http://localhost:4200"

# Google OAuth 2.0 — create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client ID → Web application). The authorized redirect URI must match GOOGLE_CALLBACK_URL.
# (Facebook login is intentionally NOT used in Mobile Market — Google + email/password only.)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:5000/api/auth/google/callback"
